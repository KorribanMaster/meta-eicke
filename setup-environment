# Source this from the workspace root (where openembedded-core/ and meta-eicke/
# live):
#
#     . ./setup-environment [build-dir]
#
# It points TEMPLATECONF at meta-eicke's build templates and then runs
# openembedded-core's oe-init-build-env (which finds bitbake at ../bitbake),
# creating (and cd-ing into) the build directory.
export TEMPLATECONF="${PWD}/meta-eicke/conf/templates/default"
source openembedded-core/oe-init-build-env "${1:-build}"
