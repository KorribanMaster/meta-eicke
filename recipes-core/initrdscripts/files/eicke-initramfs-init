#!/bin/sh
# Eicke production initramfs init (PID 1 before switch_root).
#
# Replaces the overlayfs-etc preinit. Sequence:
#   1. mount pseudo-fs
#   2. find the active rootfs slot (root=PARTLABEL=rootfs_a|b from cmdline) and
#      the data partition (GPT PARTLABEL "data")
#   3. unlock the LUKS2 /data: unseal its passphrase from the TPM (sealed to
#      PCR7 = UEFI Secure Boot state) — or, on first boot, provision it
#   4. mount the read-only rootfs, lay a writable /etc overlay whose upper dir is
#      on the decrypted /data, move /data under the new root
#   5. switch_root into the rootfs (systemd)
#
# The TPM unseal only succeeds when PCR7 matches the value captured at seal
# time, i.e. only after a successful Secure Boot with the enrolled keys. A
# tampered / SB-disabled boot yields a different PCR7 and the unseal fails, so
# /data stays locked.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

LUKS_NAME=eicke_data
TMP_PP=/run/eicke-pp

msg() { echo "EICKE-INITRD: $*"; }
fail() {
    msg "FATAL: $*"
    msg "dropping to emergency shell"
    exec sh
}

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs dev      /dev 2>/dev/null
mount -t tmpfs    tmpfs    /run

# Send all initramfs output to the serial console (the kernel cmdline makes tty0
# the primary /dev/console, which a headless qemu discards).
exec >/dev/ttyS0 2>&1

# Use the kernel's in-built TPM resource manager (/dev/tpmrm0).
export TSS2_TCTI=device

# --- locate partitions -------------------------------------------------------
ROOTSPEC=
for x in $(cat /proc/cmdline); do
    case "$x" in
        root=*) ROOTSPEC="${x#root=}" ;;
    esac
done
[ -n "$ROOTSPEC" ] || fail "no root= on kernel command line"

# Resolve root=PARTLABEL=... (or LABEL=/UUID=/dev node) to a device node.
case "$ROOTSPEC" in
    /dev/*) ROOTDEV="$ROOTSPEC" ;;
    *)      ROOTDEV="$(findfs "$ROOTSPEC" 2>/dev/null)" ;;
esac
[ -b "$ROOTDEV" ] || fail "cannot resolve rootfs device from '$ROOTSPEC'"
msg "rootfs = $ROOTDEV ($ROOTSPEC)"

DATADEV="$(findfs PARTLABEL=data 2>/dev/null)"
[ -b "$DATADEV" ] || fail "cannot find data partition (PARTLABEL=data)"
msg "data   = $DATADEV"

# --- unlock / provision encrypted /data --------------------------------------
if cryptsetup isLuks "$DATADEV"; then
    msg "unsealing /data passphrase from TPM (PCR7)..."
    if ! cryptfs-tpm2 -q unseal passphrase -P sha256 -o "$TMP_PP" 2>/dev/null; then
        fail "TPM unseal failed (PCR7 mismatch?) — /data stays locked"
    fi
    cryptsetup luksOpen --key-file "$TMP_PP" "$DATADEV" "$LUKS_NAME" \
        || fail "luksOpen of $DATADEV failed"
    rm -f "$TMP_PP"
else
    msg "first boot: provisioning encrypted /data (seal passphrase to TPM PCR7)"
    cryptfs-tpm2 -q seal passphrase -P sha256 \
        || fail "TPM seal failed (no TPM, or PCR policy error)"
    cryptfs-tpm2 -q unseal passphrase -P sha256 -o "$TMP_PP" 2>/dev/null \
        || fail "TPM unseal (post-seal) failed"
    msg "luksFormat $DATADEV ..."
    cryptsetup -q luksFormat --type luks2 "$DATADEV" --key-file "$TMP_PP" \
        || fail "luksFormat failed"
    cryptsetup luksOpen --key-file "$TMP_PP" "$DATADEV" "$LUKS_NAME" \
        || fail "luksOpen (post-format) failed"
    rm -f "$TMP_PP"
    mkfs.ext4 -q -L eicke_data "/dev/mapper/$LUKS_NAME" \
        || fail "mkfs.ext4 on decrypted /data failed"
    msg "encrypted /data provisioned"
fi

# --- mount rootfs (ro) + /etc overlay on decrypted /data ---------------------
mkdir -p /sysroot
mount -o ro "$ROOTDEV" /sysroot || fail "mount rootfs ro failed"

mkdir -p /run/data
mount "/dev/mapper/$LUKS_NAME" /run/data || fail "mount decrypted /data failed"

UP=/run/data/overlay-etc/upper
WK=/run/data/overlay-etc/work
mkdir -p "$UP" "$WK"
mount -t overlay overlay \
    -o "lowerdir=/sysroot/etc,upperdir=$UP,workdir=$WK,index=off,xino=off,metacopy=off" \
    /sysroot/etc || fail "mount /etc overlay failed"

# Hand the decrypted /data to the real system at /data.
mkdir -p /sysroot/data
mount --move /run/data /sysroot/data

msg "switch_root -> systemd"
exec switch_root /sysroot /sbin/init
