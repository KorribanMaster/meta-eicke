#
# This is the meta-eicke build configuration (TEMPLATECONF). It is
# openembedded-core's default local.conf with the additions needed for the
# GRUB-EFI + A/B WIC + SWUpdate image. See the marked block at the bottom.
#

#
# Machine Selection
#
# Default to the emulated 64-bit x86 machine (boot with `runqemu`).
# For real 64-bit x86 hardware, set:  MACHINE = "genericx86-64"
# For the emulated ARM32 U-Boot variant, set:  MACHINE = "qemuarm-uboot"
MACHINE ??= "qemux86-64"

#
# Where to place downloads and shared state (kept across builds for speed)
#
#DL_DIR ?= "${TOPDIR}/downloads"
#SSTATE_DIR ?= "${TOPDIR}/sstate-cache"

#
# Distro selection
#
# Our custom systemd-based distro (meta-eicke/conf/distro/eicke.conf).
DISTRO ?= "eicke"

# Package management
PACKAGE_CLASSES ?= "package_rpm"

# Development conveniences (empty/loginable root). Remove for production images.
# (wrynose dropped the "debug-tweaks" umbrella feature; use the granular ones.)
EXTRA_IMAGE_FEATURES ?= "allow-empty-password empty-root-password allow-root-login"

USER_CLASSES ?= "buildstats"

# Delete each recipe's ${WORKDIR} as soon as it finishes building, to keep peak
# tmp/work disk usage low (important when building multiple machines/tunes, e.g.
# qemux86-64 + genericx86-64, which otherwise fill the disk and trip the
# STOPTASKS monitor below). Deploy artifacts (tmp/deploy) are kept. To retain a
# few recipes' work dirs for debugging, set e.g.
#   RM_WORK_EXCLUDE += "linux-yocto zynq-pcie-rproc"
INHERIT += "rm_work"

# Sanity / disk monitoring
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

CONF_VERSION = "2"

# ---------------------------------------------------------------------------
# meta-eicke: GRUB-EFI + A/B WIC + SWUpdate
# ---------------------------------------------------------------------------

# Boot via EFI/GRUB on the x86 machines. qemuarm-uboot boots via U-Boot and
# configures itself in its machine conf (conf/machine/qemuarm-uboot.conf), so
# these are machine-scoped: an unconditional `MACHINE_FEATURES:append = " efi"`
# would leak into every machine.
MACHINE_FEATURES:append:qemux86-64 = " efi"
MACHINE_FEATURES:append:genericx86-64 = " efi"
EFI_PROVIDER:qemux86-64 = "grub-efi"
EFI_PROVIDER:genericx86-64 = "grub-efi"

# Our custom A/B partition layout for the x86/GRUB machines (qemuarm-uboot
# sets its own WKS_FILE in the machine conf). WKS_FILE_DEPENDS pulls in the
# EFI/grub artefacts the .wks needs.
WKS_FILE:qemux86-64 = "eicke-ab.wks.in"
WKS_FILE:genericx86-64 = "eicke-ab.wks.in"

# Produce a .wic (full disk image) plus an ext4 rootfs that the SWUpdate
# .swu bundles as the A/B update payload.
IMAGE_FSTYPES:append = " wic wic.bmap ext4"

# Labels referenced by both the .wks and the GRUB config / sw-description.
ROOTFS_A_LABEL = "rootfs_a"
ROOTFS_B_LABEL = "rootfs_b"

# Install the kernel into the rootfs (/boot/bzImage) so an A/B rootfs update
# also updates the kernel; GRUB loads the kernel from the active rootfs.

# ---------------------------------------------------------------------------
# Yocto Project public mirrors (speed up builds)
# ---------------------------------------------------------------------------
# Shared-state (prebuilt artifacts) mirror — the big build-time win. Pairing it
# with the upstream hash-equivalence server lets unchanged recipes resolve to
# the same signatures the Yocto autobuilder used, so they download instead of
# rebuild. (BB_HASHSERVE = "auto" and BB_SIGNATURE_HANDLER = "OEEquivHash" are
# already openembedded-core defaults.)
BB_HASHSERVE_UPSTREAM = "wss://hashserv.yoctoproject.org/ws"
SSTATE_MIRRORS ?= "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"

# Source (downloads) pre-mirror — faster, more robust source fetches.
INHERIT += "own-mirrors"
SOURCE_MIRROR_URL = "http://downloads.yoctoproject.org/mirror/sources/"
