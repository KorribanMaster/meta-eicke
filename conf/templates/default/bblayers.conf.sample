# LAYER_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LCONF_VERSION = "7"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

# ##OEROOT## is the openembedded-core checkout (where oe-init-build-env lives).
# The other layers are siblings of it in the workspace. We deliberately do NOT
# include meta-poky (the poky distro); the build uses the custom 'eicke' distro.
BBLAYERS ?= " \
  ##OEROOT##/meta \
  ##OEROOT##/../meta-yocto/meta-yocto-bsp \
  ##OEROOT##/../meta-openembedded/meta-oe \
  ##OEROOT##/../meta-openembedded/meta-python \
  ##OEROOT##/../meta-openembedded/meta-networking \
  ##OEROOT##/../meta-swupdate \
  ##OEROOT##/../meta-eicke \
  "
