// SPDX-License-Identifier: GPL-2.0
/*
 * Trenz TE0820-02 (XCZU2CG, 1 GiB DDR4) on a TE0703 carrier, PS only.
 *
 * One file for U-Boot (arch/arm/dts) and Linux (arch/arm64/boot/dts/xilinx):
 * both trees ship zynqmp.dtsi and zynqmp-clk-ccf.dtsi with the same labels.
 * The MIO pin muxing is done by psu_init in SPL (from the Trenz reference
 * design), so there are no pinctrl nodes here. Peripherals and pins, from the
 * reference design's TE0820_2CG_1E/1.0 (REV02) board preset:
 *
 *   MIO 13-22   SD0, eMMC 8 bit, 1.8 V (reset on MIO 23)
 *   MIO 24      Ethernet PHY reset (active low)
 *   MIO 25      USB3320 ULPI PHY reset (active low)
 *   MIO 30-31   UART0, console
 *   MIO 38-39   I2C0: Si5338 clock generator (0x70), MAC EEPROM (0x50)
 *   MIO 46-51   SD1, microSD 4 bit, 3.3 V (no card detect, no write protect)
 *   MIO 52-63   USB0 ULPI, USB 2.0 host
 *   MIO 64-77   GEM3 RGMII + MDIO, Marvell 88E151x PHY at address 1
 *
 * Not described: the dual-parallel QSPI flash (mainline spi-zynqmp-gqspi has
 * no parallel mode), I2C1 (EMIO, needs a bitstream) and the Si5338 outputs
 * (GT and PL reference clocks only; the PS does not use them).
 */

/dts-v1/;

#include "zynqmp.dtsi"
#include "zynqmp-clk-ccf.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Trenz TE0820-02 (XCZU2CG) on TE0703";
	compatible = "trenz,te0820", "xlnx,zynqmp";

	/*
	 * In Linux mmc0 is the microSD (boot and A/B disk), as on ax7015b: the
	 * slots are mmcblk0p2/p3. The eMMC is mmc1. U-Boot swaps the two
	 * (zynqmp-te0820-u-boot.dtsi): its SPL boots SD1 as mmc device 1.
	 */
	aliases {
		ethernet0 = &gem3;
		i2c0 = &i2c0;
		mmc0 = &sdhci1;
		mmc1 = &sdhci0;
		nvmem0 = &eeprom;
		serial0 = &uart0;
		usb0 = &usb0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* REV02: 1 GiB (the 2 GiB REV03 psu_init addresses it unchanged). */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x40000000>;
	};

	/*
	 * rpmsg shared memory of the two R5s (RustAmp zynqmp-r5-echo), after
	 * their rproc_N_fw_image carve-outs from zynqmp.dtsi (resource table
	 * and trace buffer): two 16 KiB vrings and a buffer pool each. The
	 * firmware has the same addresses built in (board.rs); R5_1's pool is
	 * 512 KiB so both stay in the R5s' uncached window below 0x3f000000.
	 * remoteproc finds them by node name per core, so both cores' nodes
	 * are vdev0*.
	 */
	reserved-memory {
		rpu0vdev0vring0: vdev0vring0@3ed40000 {
			no-map;
			reg = <0x0 0x3ed40000 0x0 0x4000>;
		};

		rpu0vdev0vring1: vdev0vring1@3ed44000 {
			no-map;
			reg = <0x0 0x3ed44000 0x0 0x4000>;
		};

		rpu0vdev0buffer: vdev0buffer@3ed48000 {
			no-map;
			compatible = "shared-dma-pool";
			reg = <0x0 0x3ed48000 0x0 0x100000>;
		};

		rpu1vdev0vring0: vdev0vring0@3ef40000 {
			no-map;
			reg = <0x0 0x3ef40000 0x0 0x4000>;
		};

		rpu1vdev0vring1: vdev0vring1@3ef44000 {
			no-map;
			reg = <0x0 0x3ef44000 0x0 0x4000>;
		};

		rpu1vdev0buffer: vdev0buffer@3ef48000 {
			no-map;
			compatible = "shared-dma-pool";
			reg = <0x0 0x3ef48000 0x0 0x80000>;
		};
	};
};

/*
 * The R5 cluster in split mode, so both cores run firmware of their own
 * (xlnx_r5_remoteproc; zynqmp.dtsi enables lockstep by default). Each core
 * gets its carve-outs and the IPI mailbox to the APU (channel 0): R5_0 is
 * IPI channel 1, R5_1 channel 2. The message buffers follow the IPI buffer
 * layout (agent regions of 0x200 bytes: RPU0 0xff990000, RPU1 0xff990200,
 * APU 0xff990400; 0x40 per destination: RPU0 0, RPU1 1, APU 2), as for the
 * PMU mailbox in zynqmp.dtsi; the firmware itself only uses the doorbells.
 */
&rproc_lockstep {
	status = "disabled";
};

&rproc_split {
	status = "okay";

	r5f@0 {
		memory-region = <&rproc_0_fw_image>, <&rpu0vdev0vring0>,
				<&rpu0vdev0vring1>, <&rpu0vdev0buffer>;
		mboxes = <&ipi_mailbox_rpu0 0>, <&ipi_mailbox_rpu0 1>;
		mbox-names = "tx", "rx";
	};

	r5f@1 {
		memory-region = <&rproc_1_fw_image>, <&rpu1vdev0vring0>,
				<&rpu1vdev0vring1>, <&rpu1vdev0buffer>;
		mboxes = <&ipi_mailbox_rpu1 0>, <&ipi_mailbox_rpu1 1>;
		mbox-names = "tx", "rx";
	};
};

&zynqmp_ipi {
	ipi_mailbox_rpu0: mailbox@ff990400 {
		compatible = "xlnx,zynqmp-ipi-dest-mailbox";
		reg = <0x0 0xff990400 0x0 0x20>,
		      <0x0 0xff990420 0x0 0x20>,
		      <0x0 0xff990080 0x0 0x20>,
		      <0x0 0xff9900a0 0x0 0x20>;
		reg-names = "local_request_region",
			    "local_response_region",
			    "remote_request_region",
			    "remote_response_region";
		#mbox-cells = <1>;
		xlnx,ipi-id = <1>;
	};

	ipi_mailbox_rpu1: mailbox@ff990440 {
		compatible = "xlnx,zynqmp-ipi-dest-mailbox";
		reg = <0x0 0xff990440 0x0 0x20>,
		      <0x0 0xff990460 0x0 0x20>,
		      <0x0 0xff990280 0x0 0x20>,
		      <0x0 0xff9902a0 0x0 0x20>;
		reg-names = "local_request_region",
			    "local_response_region",
			    "remote_request_region",
			    "remote_response_region";
		#mbox-cells = <1>;
		xlnx,ipi-id = <2>;
	};
};

/*
 * The XCZU2CG has two Cortex-A53 cores; zynqmp.dtsi describes four. Drop
 * cpu2/cpu3 and everything that points at them (PSCI would otherwise try to
 * bring them up and fail).
 */
/delete-node/ &cpu2;
/delete-node/ &cpu3;
/delete-node/ &cpu2_debug;
/delete-node/ &cpu3_debug;

&{/pmu} {
	interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-affinity = <&cpu0>, <&cpu1>;
};

&{/thermal-zones/apu-thermal/cooling-maps/map} {
	cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
			 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
};

&uart0 {
	status = "okay";
};

/*
 * System monitor, PS block (LPD/FPD temperatures and supplies): without it
 * xilinx-ams registers no channels and the APU/RPU thermal zones of
 * zynqmp.dtsi (channels 7 and 8) fail to probe. The PL block is only
 * accessible once the PL is configured, which this PS-only design never
 * does, so ams_pl stays disabled and the PL sensor and its thermal zone
 * (channel 20) are dropped.
 */
&ams_ps {
	status = "okay";
};

/* hwmon over the PS block's 20 channels only (zynqmp.dtsi lists PS + PL). */
&{/ams} {
	io-channels = <&xilinx_ams 0>, <&xilinx_ams 1>, <&xilinx_ams 2>,
		      <&xilinx_ams 3>, <&xilinx_ams 4>, <&xilinx_ams 5>,
		      <&xilinx_ams 6>, <&xilinx_ams 7>, <&xilinx_ams 8>,
		      <&xilinx_ams 9>, <&xilinx_ams 10>, <&xilinx_ams 11>,
		      <&xilinx_ams 12>, <&xilinx_ams 13>, <&xilinx_ams 14>,
		      <&xilinx_ams 15>, <&xilinx_ams 16>, <&xilinx_ams 17>,
		      <&xilinx_ams 18>, <&xilinx_ams 19>;
};

/ {
	/delete-node/ thermal-sensor-pl;

	thermal-zones {
		/delete-node/ pl-thermal;
	};
};

&gpio {
	status = "okay";
};

&sdhci0 {
	status = "okay";
	bus-width = <8>;
	non-removable;
	disable-wp;
	xlnx,mio-bank = <0>;
};

&sdhci1 {
	status = "okay";
	bus-width = <4>;
	no-1-8-v;
	broken-cd;
	disable-wp;
	xlnx,mio-bank = <1>;
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	/* Factory MAC address at 0xfa (EUI-48). */
	eeprom: eeprom@50 {
		compatible = "microchip,24aa025", "atmel,24c02";
		reg = <0x50>;
		#address-cells = <1>;
		#size-cells = <1>;

		eth0_addr: mac-address@fa {
			reg = <0xfa 0x6>;
		};
	};
};

&gem3 {
	status = "okay";
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	nvmem-cells = <&eth0_addr>;
	nvmem-cell-names = "mac-address";

	mdio: mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		phy0: ethernet-phy@1 {
			reg = <1>;
			reset-gpios = <&gpio 24 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <10000>;
		};
	};
};

/*
 * USB 2.0 only (ULPI, no GT lane). The glue pulses the ULPI PHY reset. Only
 * the bus clock, as in the Trenz device tree: zynqmp-clk-ccf.dtsi also
 * assigns USB3_DUAL_REF, which this design does not set up for USB 3.
 */
&usb0 {
	status = "okay";
	clock-names = "bus_clk";
	clocks = <&zynqmp_clk USB0_BUS_REF>;
	assigned-clocks = <&zynqmp_clk USB0_BUS_REF>;
	reset-gpios = <&gpio 25 GPIO_ACTIVE_LOW>;
};

&dwc3_0 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "high-speed";
};
