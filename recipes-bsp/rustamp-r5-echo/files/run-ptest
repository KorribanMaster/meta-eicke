#!/bin/sh
# ptest entry point: start the RustAmp Cortex-R5F firmware on both R5s, run
# the rpmsg echo test on both at once and reload them twice. Prints
# PASS:/FAIL: lines for ptest-runner. rpmsg_bench.py (latency and throughput)
# is not part of it: run it by hand once the firmware is up.
cd "$(dirname "$0")"
if python3 ./rpmsg_echo_test.py; then
    echo "PASS: rustamp-r5-echo"
else
    echo "FAIL: rustamp-r5-echo"
    exit 1
fi
