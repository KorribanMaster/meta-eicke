+/// Reset handler, replacing aarch32-rt's `_default_start`: that one takes
+/// the core ID from MPIDR and parks every core but 0, but in split mode each
+/// R5 runs its own image from its own TCMs, so R5_1 (MPIDR affinity 1) is
+/// core 0 of its program too. Initialise `.data`/`.bss`, then start up with
+/// core ID 0 (its stacks).
+#[unsafe(naked)]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn _start() {
+    core::arch::naked_asm!(
+        "bl _asm_init_segments",
+        "mov r0, #0",
+        "b _asm_core_start",
+    );
+}
