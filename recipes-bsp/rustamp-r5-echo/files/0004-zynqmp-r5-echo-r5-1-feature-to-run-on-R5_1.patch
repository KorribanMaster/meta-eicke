@@ -1,9 +1,21 @@
 // SPDX-License-Identifier: BSD-3-Clause
-//! Puts `memory.x` (included by aarch32-rt's `link.x`) on the linker path.
-use std::env;
+//! Writes `memory.x` (included by aarch32-rt's `link.x`) from `memory.x.in`
+//! into `OUT_DIR` and puts that on the linker path. With the `r5-1` feature
+//! its DDR regions move from `rproc_0_fw_image` (0x3ED00000) to
+//! `rproc_1_fw_image` (0x3EF00000), as in `board.rs`. (The template is not
+//! named `memory.x`: ld looks for INCLUDEd files in the current directory,
+//! the package root, before the -L paths.)
+use std::{env, fs, path::Path};
 
 fn main() {
     let dir = env::var("CARGO_MANIFEST_DIR").unwrap();
-    println!("cargo:rustc-link-search={dir}");
-    println!("cargo:rerun-if-changed=memory.x");
+    let out = env::var("OUT_DIR").unwrap();
+    let mut x = fs::read_to_string(Path::new(&dir).join("memory.x.in")).unwrap();
+    if env::var_os("CARGO_FEATURE_R5_1").is_some() {
+        assert_eq!(x.matches("ORIGIN = 0x3ED0").count(), 2, "memory.x.in DDR regions");
+        x = x.replace("ORIGIN = 0x3ED0", "ORIGIN = 0x3EF0");
+    }
+    fs::write(Path::new(&out).join("memory.x"), x).unwrap();
+    println!("cargo:rustc-link-search={out}");
+    println!("cargo:rerun-if-changed=memory.x.in");
 }
