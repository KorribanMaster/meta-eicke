/*
 * SWUpdate description for the Eicke A/B (dual-copy) update.
 *
 * Two modes select which slot to write:
 *   - stable.copy1 : run while booted on slot A -> writes rootfs_b, boots B next
 *   - stable.copy2 : run while booted on slot B -> writes rootfs_a, boots A next
 *
 * Apply (from the running target), e.g. when currently on slot A:
 *     swupdate -i eicke-update-image-<machine>.swu -e stable,copy1
 *
 * @@IMAGE_MACHINE_SUFFIX@@ is expanded by the swupdate bbclass to e.g.
 * "-qemux86-64", giving the deployed rootfs basename
 * "eicke-image-qemux86-64.rootfs.ext4" (matching SWUPDATE_IMAGES_FSTYPES). The
 * leading "@" on the sha256 line is the class's sha256 placeholder, replaced
 * with the artifact's real hash at build time.
 */
software =
{
    version = "1.0";
    description = "Eicke A/B rootfs update";

    hardware-compatibility: [ "1.0" ];

    stable:
    {
        copy1:
        {
            images: (
                {
                    filename = "eicke-image@@IMAGE_MACHINE_SUFFIX@@.rootfs.ext4";
                    device   = "/dev/disk/by-partlabel/rootfs_b";
                    type     = "raw";
                    sha256   = "@eicke-image@@IMAGE_MACHINE_SUFFIX@@.rootfs.ext4";
                }
            );
            bootenv: (
                { name = "rootdev";   value = "rootfs_b"; },
                { name = "ustate";    value = "1"; },
                { name = "bootcount"; value = "0"; }
            );
        };

        copy2:
        {
            images: (
                {
                    filename = "eicke-image@@IMAGE_MACHINE_SUFFIX@@.rootfs.ext4";
                    device   = "/dev/disk/by-partlabel/rootfs_a";
                    type     = "raw";
                    sha256   = "@eicke-image@@IMAGE_MACHINE_SUFFIX@@.rootfs.ext4";
                }
            );
            bootenv: (
                { name = "rootdev";   value = "rootfs_a"; },
                { name = "ustate";    value = "1"; },
                { name = "bootcount"; value = "0"; }
            );
        };
    };
}
