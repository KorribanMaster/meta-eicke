[
  {"expect": "login:", "timeout": 900},
  {"send": "root"},
  {"expect": "root@qemux86-64:~#", "timeout": 60},
  {"send": "cat /proc/cmdline; ls -l /dev/eicke/; findmnt -no SOURCE /boot /data"},
  {"expect": "eicke.slot=rootfs_a", "timeout": 30},
  {"expect": "root@qemux86-64:~#", "timeout": 30},
  {"send": "lsblk -o NAME,SIZE,PARTLABEL | cat; swupdate -i /dev/vda"},
  {"expect": "SWUPDATE successful", "timeout": 900},
  {"send": "grub-editenv /boot/EFI/BOOT/grubenv list"},
  {"expect": "rootdev=rootfs_b", "timeout": 30},
  {"send": "reboot"},
  {"expect": "login:", "timeout": 900},
  {"send": "root"},
  {"expect": "root@qemux86-64:~#", "timeout": 60},
  {"send": "cat /proc/cmdline"},
  {"expect": "eicke.slot=rootfs_b", "timeout": 30},
  {"sleep": 20},
  {"send": "grub-editenv /boot/EFI/BOOT/grubenv list | grep ustate"},
  {"expect": "ustate=0", "timeout": 30},
  {"send": "grub-editenv /boot/EFI/BOOT/grubenv set ustate=1 bootcount=1 && echo SIMFAIL-ARMED"},
  {"expect": "SIMFAIL-ARMED", "timeout": 30},
  {"send": "reboot"},
  {"expect": "login:", "timeout": 900},
  {"send": "root"},
  {"expect": "root@qemux86-64:~#", "timeout": 60},
  {"send": "cat /proc/cmdline"},
  {"expect": "eicke.slot=rootfs_a", "timeout": 30},
  {"send": "grub-editenv /boot/EFI/BOOT/grubenv list | grep ustate"},
  {"expect": "ustate=3", "timeout": 30},
  {"send": "grub-editenv /boot/EFI/BOOT/grubenv set ustate=0 && echo CLEANED"},
  {"expect": "CLEANED", "timeout": 30},
  {"send": "poweroff"},
  {"expect": "Power down|System halted|reboot: Power", "timeout": 120}
]
