[
  {"expect": "login:", "timeout": 900},
  {"send": "root"},
  {"expect": "root@qemuimx8mp-evk:~#", "timeout": 60},
  {"send": "cat /proc/cmdline; ls -l /dev/eicke/; grep -E ' /(boot|data) ' /proc/mounts"},
  {"expect": "eicke.slot=rootfs_a", "timeout": 30},
  {"expect": "root@qemuimx8mp-evk:~#", "timeout": 30},
  {"send": "ptest-runner rustamp-m7-echo; echo PTEST-RC=$?"},
  {"expect": "PASS: [0-9]+ round trips", "timeout": 600},
  {"expect": "PTEST-RC=0", "timeout": 120},
  {"send": "for d in /sys/block/mmcblk*; do [ -e $d/${d##*/}p1 ] || SWU=/dev/${d##*/}; done; echo swu=$SWU; swupdate -i $SWU"},
  {"expect": "SWUPDATE successful", "timeout": 1200},
  {"send": "fw_printenv rootdev ustate"},
  {"expect": "rootdev=rootfs_b", "timeout": 30},
  {"expect": "ustate=1", "timeout": 10},
  {"send": "poweroff"},
  {"expect": "Power down|System halted|reboot: Power", "timeout": 180}
]
