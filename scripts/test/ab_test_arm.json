[
  {"expect": "U-Boot 20", "timeout": 120},
  {"expect": "Loading Environment from FAT... OK", "timeout": 60},
  {"expect": "Eicke Linux \\(rootfs_a\\)", "timeout": 60},
  {"expect": "login:", "timeout": 600},
  {"send": "root"},
  {"expect": "root@qemuarm-uboot:~#", "timeout": 60},
  {"send": "cat /proc/cmdline"},
  {"expect": "eicke.slot=rootfs_a", "timeout": 30},
  {"send": "fw_printenv rootdev ustate bootcount"},
  {"expect": "rootdev=rootfs_a", "timeout": 30},
  {"expect": "ustate=0", "timeout": 10},
  {"send": "swupdate -i /dev/vdb"},
  {"expect": "SWUPDATE successful", "timeout": 900},
  {"send": "fw_printenv rootdev ustate"},
  {"expect": "rootdev=rootfs_b", "timeout": 30},
  {"expect": "ustate=1", "timeout": 10},
  {"send": "reboot"},
  {"expect": "Eicke Linux \\(rootfs_b\\)", "timeout": 300},
  {"expect": "login:", "timeout": 600},
  {"send": "root"},
  {"expect": "root@qemuarm-uboot:~#", "timeout": 60},
  {"send": "cat /proc/cmdline"},
  {"expect": "eicke.slot=rootfs_b", "timeout": 30},
  {"sleep": 20},
  {"send": "fw_printenv ustate bootcount"},
  {"expect": "ustate=0", "timeout": 30},
  {"send": "fw_setenv ustate 1 && fw_setenv bootcount 1 && echo SIMFAIL-ARMED"},
  {"expect": "SIMFAIL-ARMED", "timeout": 30},
  {"send": "reboot"},
  {"expect": "Eicke Linux \\(rootfs_a\\)", "timeout": 300},
  {"expect": "login:", "timeout": 600},
  {"send": "root"},
  {"expect": "root@qemuarm-uboot:~#", "timeout": 60},
  {"send": "cat /proc/cmdline"},
  {"expect": "eicke.slot=rootfs_a", "timeout": 30},
  {"send": "fw_printenv ustate"},
  {"expect": "ustate=3", "timeout": 30},
  {"send": "fw_setenv ustate 0 && echo CLEANED"},
  {"expect": "CLEANED", "timeout": 30},
  {"send": "poweroff"},
  {"expect": "Power down|System halted|reboot: Power", "timeout": 120}
]
