#!/bin/sh
# Runtime AD936x settings kept in uboot.env, as on an ADALM-Pluto (pluto-fw
# S21misc):
#   xo_correction        reference clock correction in Hz (e.g. 40000123)
#   iio_max_block_size   largest IIO DMA block in bytes (default 64 MiB)
# Set them with fw_setenv and reboot. The variant (ad936x_model,
# ad936x_mode) is applied by U-Boot, which patches the device tree.

# The ad9361 driver probes at boot; give it a moment if we got here first.
dev=""
i=0
while [ -z "$dev" ] && [ $i -lt 50 ]; do
    for d in /sys/bus/iio/devices/iio:device*; do
        [ "$(cat $d/name 2>/dev/null)" = ad9361-phy ] && dev=$d
    done
    [ -n "$dev" ] || { i=$((i + 1)); sleep 0.2; }
done
[ -n "$dev" ] || { echo "ad936x-config: no ad9361-phy" >&2; exit 1; }

xo=$(fw_printenv -n xo_correction 2>/dev/null || true)
[ -z "$xo" ] || echo "$xo" > $dev/xo_correction

bs=$(fw_printenv -n iio_max_block_size 2>/dev/null || echo 67108864)
echo "$bs" > /sys/module/industrialio_buffer_dma/parameters/max_block_size

echo "ad936x-config: $(cat $dev/of_node/compatible | tr '\0' ' ')xo $(cat $dev/xo_correction) Hz, max block $bs"
