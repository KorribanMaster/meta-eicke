#!/bin/sh
# Confirm a healthy boot for the SWUpdate A/B scheme.
#
# Clears the swupdate trial state (ustate/bootcount) in the GRUB environment
# once userspace has come up, so GRUB does not roll back to the previous slot on
# the next reboot. This is a minimal "we reached userspace" confirmation; for a
# stricter policy, gate the grub-editenv call on an application health check
# before clearing ustate.

GRUBENV=/boot/EFI/BOOT/grubenv

if [ ! -f "$GRUBENV" ]; then
    logger -t eicke-bootconfirm "grubenv $GRUBENV not found; skipping"
    exit 0
fi

# Only act while an update is on trial.
ustate=$(grub-editenv "$GRUBENV" list 2>/dev/null | sed -n 's/^ustate=//p')
if [ "$ustate" = "1" ]; then
    grub-editenv "$GRUBENV" set ustate=0 bootcount=0
    logger -t eicke-bootconfirm "boot confirmed: ustate -> 0 (slot accepted)"
fi

exit 0
