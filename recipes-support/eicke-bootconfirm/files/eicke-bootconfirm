#!/bin/sh
# Confirm a healthy boot for the SWUpdate A/B scheme.
#
# Clears the swupdate trial state (ustate/bootcount) in the bootloader
# environment once userspace has come up, so the bootloader does not roll back
# to the previous slot on the next reboot. This is a minimal "we reached
# userspace" confirmation; for a stricter policy, gate the confirm call on an
# application health check before clearing ustate.
#
# Backend-agnostic: GRUB (grubenv on the ESP, x86 machines) or U-Boot
# (uboot.env on the boot partition via libubootenv, qemuarm-uboot). The
# bootloader-specific tool is installed by the image's eicke-ab-*.inc. The
# trial-gate lifecycle + logging are shared with eicke-ipxeconfirm via
# eicke-confirm-lib.sh.

. /usr/libexec/eicke-confirm-lib.sh

TAG=eicke-bootconfirm
GRUBENV=/boot/EFI/BOOT/grubenv

if command -v grub-editenv >/dev/null 2>&1 && [ -f "$GRUBENV" ]; then
    get_ustate() { grub-editenv "$GRUBENV" list 2>/dev/null | sed -n 's/^ustate=//p'; }
    confirm() { grub-editenv "$GRUBENV" set ustate=0 bootcount=0; }
elif command -v fw_printenv >/dev/null 2>&1; then
    get_ustate() { fw_printenv -n ustate 2>/dev/null; }
    # Two separate writes (fw_setenv -s needs a real file, not stdin). Order
    # matters: clear ustate first — if interrupted in between, ustate=0 already
    # disarms the trial and the stale bootcount is ignored by bootcmd.
    confirm() { fw_setenv ustate 0 && fw_setenv bootcount 0; }
else
    eicke_log "$TAG" "no bootloader env tool found; skipping"
    exit 0
fi

eicke_confirm_on_trial "$TAG" get_ustate confirm
exit 0
