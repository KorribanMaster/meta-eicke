#
# SWUpdate configuration for meta-eicke (x86-64, GRUB-EFI A/B, local updates).
#
# Based on meta-swupdate's shipped default defconfig, with these changes:
#   * MTD/CFI disabled  -> x86 uses block devices, not raw flash (avoids the
#     mtd-utils/libmtd.h dependency the recipe only adds when CONFIG_MTD/CFI=y).
#   * U-Boot backend off, GRUB environment backend on + made the default.
#   * Bootloader handler enabled so sw-description `bootenv` entries are applied
#     (flips `rootdev`/`ustate` in grubenv after writing the standby slot).
#   * GRUBENV_PATH points at the ESP (mounted at /boot) -> /boot/EFI/BOOT/grubenv.
#   * Local updates only: Mongoose web server + Lua/raw/script handlers; no
#     CURL/DOWNLOAD/SURICATTA (no hawkBit).
#   * HW_COMPATIBILITY on: every image ships /etc/hwrevision (eicke-hwrevision)
#     and every sw-description lists the matching machine, so a bundle built
#     for another machine is rejected before anything is written.
#
# Regenerate authoritatively with `bitbake -c menuconfig swupdate` if needed.
#
CONFIG_HAVE_DOT_CONFIG=y

#
# General Configuration
#
# CONFIG_CURL is not set
# CONFIG_CURL_SSL is not set
# CONFIG_SYSTEMD is not set
# (meta-swupdate ships a Type=notify unit; rather than build swupdate against
# libsystemd for sd_notify, we override the unit to Type=simple via a drop-in in
# the swupdate bbappend, so systemd doesn't time out waiting for readiness.)
CONFIG_DEFAULT_CONFIG_FILE="/etc/swupdate.cfg"
CONFIG_SCRIPTS=y
# Hardware-revision gating: refuse a .swu whose sw-description
# hardware-compatibility list does not contain this device's revision (second
# field of /etc/hwrevision, shipped by the eicke-hwrevision recipe as the
# bitbake MACHINE). Contract: with this compiled in, swupdate hard-fails when
# /etc/hwrevision is absent or a sw-description carries no
# hardware-compatibility -- so ALL images install eicke-hwrevision and ALL
# sw-descriptions list "@@MACHINE@@". Pre-change bundles (no
# hardware-compatibility attribute) are rejected by the new binary; old
# binaries silently ignore the new attribute.
CONFIG_HW_COMPATIBILITY=y
CONFIG_SW_VERSIONS_FILE="/etc/sw-versions"

#
# Socket Paths
#
CONFIG_SOCKET_CTRL_PATH=""
CONFIG_SOCKET_PROGRESS_PATH=""
CONFIG_SOCKET_REMOTE_HANDLER_DIRECTORY="/tmp/"
# CONFIG_MTD is not set
CONFIG_LUA=y
CONFIG_LUAPKG="lua"
# CONFIG_FEATURE_SYSLOG is not set

#
# Build Options
#
CONFIG_CROSS_COMPILE=""
CONFIG_SYSROOT=""
CONFIG_EXTRA_LDLIBS=""

#
# Debugging Options
#
# CONFIG_DEBUG is not set
# CONFIG_WERROR is not set
# CONFIG_NOCLEANUP is not set

#
# Bootloader: GRUB environment block (no U-Boot, no EFI Boot Guard)
#
# CONFIG_BOOTLOADER_EBG is not set
# CONFIG_UBOOT is not set
# CONFIG_BOOTLOADER_NONE is not set
CONFIG_BOOTLOADER_GRUB=y
CONFIG_GRUBENV_PATH="/boot/EFI/BOOT/grubenv"
CONFIG_BOOTLOADER_DEFAULT_GRUB=y
# CONFIG_SSL_IMPL_NONE is not set
CONFIG_SSL_IMPL_OPENSSL=y
# CONFIG_SSL_IMPL_MBEDTLS is not set
# CONFIG_DOWNLOAD is not set
# Verify the sha256 supplied in sw-description (we embed real hashes at build).
CONFIG_HASH_VERIFY=y
# Require a valid RSA-PSS signature over sw-description before installing. This
# makes swupdate refuse any unsigned/tampered .swu; the public key is passed at
# runtime (-k /etc/swupdate/public.pem). Note this is global to the swupdate
# binary, so EVERY eicke image now verifies and EVERY .swu must be signed.
CONFIG_SIGNED_IMAGES=y
CONFIG_SIGALG_RSAPSS=y
# CONFIG_SIGALG_CMS is not set
# CONFIG_SIGALG_RAWRSA is not set
# CONFIG_SIGALG_GPG is not set
# CONFIG_SIGALG_ED25519 is not set
# CONFIG_ENCRYPTED_IMAGES is not set
# CONFIG_SURICATTA is not set
CONFIG_WEBSERVER=y
CONFIG_MONGOOSE=y
CONFIG_MONGOOSEIPV6=y
CONFIG_MONGOOSESSL=y
CONFIG_GUNZIP=y
# CONFIG_ZSTD is not set

#
# Parser Features
#
CONFIG_LIBCONFIG=y
CONFIG_PARSERROOT=""
# CONFIG_JSON is not set
# CONFIG_LUAEXTERNAL is not set
# CONFIG_SETSWDESCRIPTION is not set

#
# Image Handlers
#
# CONFIG_UBIVOL is not set
# CONFIG_CFI is not set
# CONFIG_DISKPART is not set
CONFIG_RAW=y
# CONFIG_RDIFFHANDLER is not set
CONFIG_LUASCRIPTHANDLER=y
CONFIG_SHELLSCRIPTHANDLER=y
# CONFIG_HANDLER_IN_LUA is not set
# CONFIG_ARCHIVE is not set
# CONFIG_REMOTE_HANDLER is not set
# CONFIG_SWUFORWARDER_HANDLER is not set
CONFIG_BOOTLOADERHANDLER=y
# CONFIG_SSBLSWITCH is not set
# CONFIG_UCFWHANDLER is not set
